# Canonical site URL, used for metadata/sitemap/OG image generation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Azure Application Insights connection string (server-side monitoring). Leave blank to disable.
APPLICATIONINSIGHTS_CONNECTION_STRING=""
