# Postgres connection string. For local dev with docker-compose:
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

# Resend (https://resend.com) — used to email the site owner on contact form submissions.
RESEND_API_KEY=""
# Verified "from" address in Resend, and the inbox that should receive submissions.
CONTACT_FROM_EMAIL="Portfolio Contact Form <onboarding@resend.dev>"
CONTACT_TO_EMAIL="pranay0880@gmail.com"

# Public resume link, opened by the "Resume" button in the hero section.
NEXT_PUBLIC_RESUME_URL=""

# Canonical site URL, used for metadata/sitemap/OG image generation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Azure Application Insights connection string (server-side monitoring). Leave blank to disable.
APPLICATIONINSIGHTS_CONNECTION_STRING=""
